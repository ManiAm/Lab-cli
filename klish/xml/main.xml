<?xml version="1.0" encoding="UTF-8"?>
<KLISH
    xmlns="https://klish.libcode.org/klish3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://klish.libcode.org/klish3 https://src.libcode.org/pkun/klish/src/3.2.0/klish.xsd">

    <PLUGIN name="klish" />
    <PLUGIN name="script" />
    <PLUGIN name="lua" />

    <PTYPE name="STRING" help="Standard string">
        <ACTION sym="STRING" />
    </PTYPE>

    <PTYPE name="INT" help="Number of lines">
        <ACTION sym="INT"/>
    </PTYPE>

    <PTYPE name="PTYPE_FORMAT" help="Output format">
        <ACTION sym="script">
            case "${KLISH_VALUE}" in json|xml|csv) exit 0 ;; esac; exit 1
        </ACTION>
        <COMPL>
            <ACTION sym="script">echo "json"; echo "xml"; echo "csv"</ACTION>
        </COMPL>
    </PTYPE>

    <PTYPE name="PTYPE_IPV4" help="Enter a valid IPv4 address (e.g. 192.168.1.1)">
        <ACTION sym="script">
            echo "${KLISH_VALUE}" | grep -qE "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
        </ACTION>
    </PTYPE>

    <PTYPE name="DYN_IFACE" help="Network Interface">
        <ACTION sym="script">
            if [ -d "/sys/class/net/${KLISH_VALUE}" ]; then
                exit 0
            fi
            echo "Error: Interface ${KLISH_VALUE} does not exist."
            exit 1
        </ACTION>
        <COMPL>
            <ACTION sym="script">
                ls /sys/class/net 2>/dev/null
            </ACTION>
        </COMPL>
    </PTYPE>

    <VIEW name="main" help="Top-level view">

        <PROMPT name="prompt">
            <ACTION sym="prompt">NetLab# </ACTION>
        </PROMPT>

        <LOG>
            <ACTION sym="script">
                echo "${KLISH_PARENT_LINE}" >> /tmp/klish_history.log
            </ACTION>
        </LOG>

        <COMMAND name="history" value="his|tory" help="Display command history">
            <ACTION sym="script">
                if [ -f /tmp/klish_history.log ]; then
                    # 'nl' adds line numbers, -w3 sets width, -s sets separator
                    nl -w3 -s"  " /tmp/klish_history.log
                else
                    echo "No history available."
                fi
            </ACTION>
        </COMMAND>

        <COMMAND name="exit" help="Exit">
            <ACTION sym="nav@klish">pop</ACTION>
        </COMMAND>

        <COMMAND name="clear" help="Clear the terminal screen">
            <ACTION sym="script">
                clear
            </ACTION>
        </COMMAND>

        <COMMAND name="show" help="Show system information">
            <SWITCH name="show_options">

                <COMMAND name="interface" help="Show interface details">
                    <PARAM name="iface" help="Select interface" ptype="/DYN_IFACE" />
                    <ACTION sym="script">
                        ip addr show ${KLISH_PARAM_iface}
                    </ACTION>
                    <COMMAND name="format" min="0" help="Output format">
                        <PARAM name="fmt" help="json, xml, csv" ptype="/PTYPE_FORMAT"/>
                        <ACTION sym="script">
                            ip -j addr show ${KLISH_PARAM_iface} | python3 /opt/netlab-cli/scripts/text_to_format.py "${KLISH_PARAM_fmt}"
                        </ACTION>
                    </COMMAND>
                </COMMAND>

                <COMMAND name="ip" help="Show IP-related information">
                    <COMMAND name="interface" help="Show all interfaces with IP configuration">
                        <ACTION sym="script">
                            ip -brief addr show
                        </ACTION>
                        <COMMAND name="format" min="0" help="Output format">
                            <PARAM name="fmt" help="json, xml, csv" ptype="/PTYPE_FORMAT"/>
                            <ACTION sym="script">
                                ip -j addr show | python3 /opt/netlab-cli/scripts/text_to_format.py "${KLISH_PARAM_fmt}"
                            </ACTION>
                        </COMMAND>
                    </COMMAND>
                </COMMAND>

                <COMMAND name="version" help="Show system version">
                    <ACTION sym="script">uname -a</ACTION>
                    <COMMAND name="format" min="0" help="Output format">
                        <PARAM name="fmt" help="json, xml, csv" ptype="/PTYPE_FORMAT"/>
                        <ACTION sym="script">
python3 -c "
import json, platform
d = {'system': platform.system(), 'node': platform.node(),
     'release': platform.release(), 'version': platform.version(),
     'machine': platform.machine()}
print(json.dumps(d))
" | python3 /opt/netlab-cli/scripts/text_to_format.py "${KLISH_PARAM_fmt}"
                        </ACTION>
                    </COMMAND>
                </COMMAND>

                <COMMAND name="bgp" help="Show BGP information">
                    <SWITCH name="show_bgp_options">
                        <COMMAND name="summary" help="Show BGP summary">
                            <ACTION sym="script">
                                echo "BGP Summary (simulated)"
                                echo "Router ID: 10.0.0.1, AS: 65001"
                                echo "Neighbor        AS   State       Up/Down"
                                echo "10.0.0.2     65002   Established 01:23:45"
                                echo "10.0.0.3     65003   Established 00:45:12"
                            </ACTION>
                        </COMMAND>
                        <COMMAND name="neighbors" help="Show BGP neighbors">
                            <ACTION sym="script">
                                echo "BGP Neighbors (simulated)"
                                echo "Neighbor: 10.0.0.2, Remote AS: 65002"
                                echo "  State: Established, Uptime: 01:23:45"
                                echo "Neighbor: 10.0.0.3, Remote AS: 65003"
                                echo "  State: Established, Uptime: 00:45:12"
                            </ACTION>
                        </COMMAND>
                    </SWITCH>
                </COMMAND>

                <COMMAND name="interfaces" help="Show all interfaces">
                    <SWITCH name="show_interfaces_options">
                        <COMMAND name="counters" help="Show interface counters">
                            <ACTION sym="script">
                                echo "Interface Counters (simulated)"
                                ip -s link show 2>/dev/null || echo "No interface data available"
                            </ACTION>
                        </COMMAND>
                        <COMMAND name="summary" help="Show interface summary">
                            <ACTION sym="script">
                                echo "Interface Summary (simulated)"
                                ip -brief link show 2>/dev/null || echo "No interface data available"
                            </ACTION>
                        </COMMAND>
                    </SWITCH>
                </COMMAND>

                <COMMAND name="running-config" help="Show running configuration">
                    <ACTION sym="script">
                        echo "Running Configuration (simulated)"
                        echo "!"
                        echo "hostname NetLab"
                        echo "!"
                        echo "interface lo"
                        echo "  ip address 127.0.0.1/8"
                        echo "!"
                    </ACTION>
                </COMMAND>

                <COMMAND name="greeting" help="Display a welcome message">
                    <ACTION sym="script">
                        /opt/netlab-cli/scripts/show_greeting.sh
                    </ACTION>
                </COMMAND>

                <COMMAND name="terminal" help="Display terminal information">
                    <COMMAND name="session" help="Show current session details">
                        <ACTION sym="lua">
                            local ctx = klish.context()
                            print("--- Session Information ---")
                            print("Session PID: " .. ctx.pid)
                            print("User ID:     " .. ctx.uid)
                            print("User Name:   " .. ctx.user)
                            print("Command:     " .. ctx.cmd)
                        </ACTION>
                    </COMMAND>
                </COMMAND>

            </SWITCH>
        </COMMAND>

        <COMMAND name="ping" help="Ping a destination">
            <PARAM name="ip"
                help="Destination IP address"
                ptype="/PTYPE_IPV4" />
            <ACTION sym="script">
                echo "Pinging ${ip}..."
                ping -c 4 "${KLISH_PARAM_ip}"
            </ACTION>
        </COMMAND>

        <COMMAND name="tree" help="Dump CLI structure tree">
            <ACTION sym="script">
                python3 /opt/netlab-cli/scripts/xml_tree.py /root/.klish/main.xml
            </ACTION>
        </COMMAND>

        <COMMAND name="search" help="Search for a CLI command">
            <PARAM name="query" help="Search term" ptype="/STRING" />
            <ACTION sym="script">
                python3 /opt/netlab-cli/scripts/cli_search.py /root/.klish/main.xml "${KLISH_PARAM_query}"
            </ACTION>
        </COMMAND>

        <COMMAND name="traceroute" help="Trace route to a destination">
            <PARAM name="ip"
                help="Destination IP address"
                ptype="/PTYPE_IPV4" />
            <ACTION sym="script">
                traceroute "${KLISH_PARAM_ip}" 2>/dev/null || echo "traceroute not available"
            </ACTION>
        </COMMAND>

        <COMMAND name="debug" help="Enable debug output">
            <SWITCH name="debug_options">
                <COMMAND name="bgp" help="Debug BGP events">
                    <ACTION sym="script">echo "Debug: BGP debugging enabled (simulated)"</ACTION>
                </COMMAND>
                <COMMAND name="daemon" help="Debug daemon events">
                    <ACTION sym="script">echo "Debug: daemon debugging enabled (simulated)"</ACTION>
                </COMMAND>
                <COMMAND name="telemetry" help="Debug telemetry events">
                    <ACTION sym="script">echo "Debug: telemetry debugging enabled (simulated)"</ACTION>
                </COMMAND>
            </SWITCH>
        </COMMAND>

        <COMMAND name="router" help="Configure a routing protocol">
            <COMMAND name="bgp" help="BGP routing protocol">
                <PARAM name="asn" help="AS number" ptype="/STRING">
                    <ACTION sym="script">
                        echo "Router BGP ${KLISH_PARAM_asn} configured (simulated)"
                    </ACTION>
                </PARAM>
            </COMMAND>
        </COMMAND>

        <COMMAND name="neighbor" help="Configure a BGP neighbor">
            <PARAM name="ip" help="Neighbor IP address" ptype="/PTYPE_IPV4">
                <COMMAND name="remote-as" help="Set remote AS number">
                    <PARAM name="asn" help="AS number" ptype="/STRING">
                        <ACTION sym="script">
                            echo "Neighbor ${KLISH_PARAM_ip} remote-as ${KLISH_PARAM_asn} configured (simulated)"
                        </ACTION>
                    </PARAM>
                </COMMAND>
            </PARAM>
        </COMMAND>

        <!-- Pipes -->

        <COMMAND name="include" help="Show lines matching pattern" filter="true">
            <PARAM name="pattern" help="Regex pattern" ptype="/STRING"/>
            <ACTION sym="script">
                # -E extended regex, -i case insensitive
                grep -Ei "${KLISH_PARAM_pattern}"
            </ACTION>
        </COMMAND>

        <COMMAND name="exclude" help="Hide lines matching pattern" filter="true">
            <PARAM name="pattern" help="Regex pattern" ptype="/STRING"/>
            <ACTION sym="script">
                grep -Eiv "${KLISH_PARAM_pattern}"
            </ACTION>
        </COMMAND>

        <COMMAND name="begin" help="Start output from first matching line" filter="true">
            <PARAM name="pattern" help="Regex pattern" ptype="/STRING"/>
            <ACTION sym="script">
                sed -n "/${KLISH_PARAM_pattern}/,\$p"
            </ACTION>
        </COMMAND>

        <COMMAND name="grep" help="Standard grep" filter="true">
            <PARAM name="pattern" help="Regex pattern" ptype="/STRING"/>
            <ACTION sym="script">
                grep --color=never -E "${KLISH_PARAM_pattern}"
            </ACTION>
        </COMMAND>

        <COMMAND name="head" help="Show first N lines" filter="true">
            <PARAM name="lines" help="Number of lines (default 10)" ptype="/INT" optional="true"/>
            <ACTION sym="script">
                # Default to 10 if no parameter provided
                L=${KLISH_PARAM_lines:-10}
                head -n "$L"
            </ACTION>
        </COMMAND>

        <COMMAND name="tail" help="Show last N lines" filter="true">
            <PARAM name="lines" help="Number of lines (default 10)" ptype="/INT" optional="true"/>
            <ACTION sym="script">
                L=${KLISH_PARAM_lines:-10}
                tail -n "$L"
            </ACTION>
        </COMMAND>

        <COMMAND name="count" help="Count lines" filter="true">
            <ACTION sym="script">
                wc -l
            </ACTION>
        </COMMAND>

        <!-- Nested Views -->

        <COMMAND name="tools" help="Enter tools mode">
            <ACTION sym="nav@klish">push view_tools</ACTION>
        </COMMAND>

        <COMMAND name="configure" help="Enter configuration mode">

            <SWITCH name="configure_options">

                <COMMAND name="terminal" help="Configure from the terminal">
                    <ACTION sym="script">
                        # Set mode to LIVE
                        echo "live" > /tmp/klish_sess_${KLISH_PID}_mode
                    </ACTION>

                    <ACTION sym="nav@klish">push view_config</ACTION>
                </COMMAND>

                <COMMAND name="session" help="Enter a named configuration session">
                    <PARAM name="sess_name" help="Session Name" ptype="STRING">
                        <ACTION sym="script">
                            # Set mode to SESSION and save the name
                            echo "session" > /tmp/klish_sess_${KLISH_PID}_mode
                            echo "${KLISH_PARAM_sess_name}" > /tmp/klish_sess_${KLISH_PID}_sess_name

                            # Create a clean staging file for this session
                            mkdir -p /tmp/candidates
                            touch /tmp/candidates/${KLISH_PARAM_sess_name}.conf
                        </ACTION>
                        <ACTION sym="nav@klish">push view_config</ACTION>
                    </PARAM>
                </COMMAND>

            </SWITCH>

        </COMMAND>

    </VIEW>

    <VIEW name="view_tools" help="Tools Sub-menu">

        <PROMPT name="prompt">
             <ACTION sym="prompt">NetLab(tools)# </ACTION>
        </PROMPT>

        <COMMAND name="date" help="Show current date">
            <ACTION sym="script">date</ACTION>
        </COMMAND>

        <COMMAND name="sys-check" help="Check system resources">

            <PARAM name="component"
                   help="Select component (cpu, memory, disk)"
                   ptype="/STRING">

                <COMPL>
                    <ACTION sym="script">echo "cpu"; echo "memory"; echo "disk"</ACTION>
                </COMPL>
            </PARAM>

            <ACTION sym="script">
                # Pass the parameter to the script
                /opt/netlab-cli/scripts/sys_info.sh "${KLISH_PARAM_component}"
            </ACTION>

        </COMMAND>

        <COMMAND name="exit" help="Go back">
            <ACTION sym="nav@klish">pop</ACTION>
        </COMMAND>

    </VIEW>

    <!-- Configure Terminal View -->

    <VIEW name="view_config">

        <PROMPT name="prompt">
            <ACTION sym="script">
                MODE=$(cat /tmp/klish_sess_${KLISH_PID}_mode 2>/dev/null)

                if [ "$MODE" = "session" ]; then
                    NAME=$(cat /tmp/klish_sess_${KLISH_PID}_sess_name 2>/dev/null)
                    echo -n "NetLab(config-session-${NAME})# "
                else
                    echo -n "NetLab(config)# "
                fi
            </ACTION>
        </PROMPT>

        <COMMAND name="interface" help="Select an interface to configure">
            <PARAM name="iface_name" help="Interface Name" ptype="/DYN_IFACE">
                <ACTION sym="script">
                    echo "${KLISH_PARAM_iface_name}" > /tmp/klish_sess_${KLISH_PID}_iface
                </ACTION>
                <ACTION sym="nav@klish">push view_interface</ACTION>
            </PARAM>
        </COMMAND>

        <COMMAND name="show" help="Show configuration information">
            <COMMAND name="candidate-config" help="Show candidate configuration (draft)">
                <ACTION sym="script">
                    SESS_NAME=$(cat /tmp/klish_sess_${KLISH_PID}_sess_name 2>/dev/null)
                    CONF_FILE="/tmp/candidates/${SESS_NAME}.conf"

                    # Check if file exists AND has content (size > 0)
                    if [ -s "$CONF_FILE" ]; then
                        cat "$CONF_FILE"
                    else
                        echo "No changes buffered."
                    fi
                </ACTION>
            </COMMAND>
        </COMMAND>

        <COMMAND name="commit" help="Apply buffered changes">
            <ACTION sym="script">
                /opt/netlab-cli/scripts/commit_session.sh
            </ACTION>
        </COMMAND>

        <COMMAND name="exit" help="Exit to main menu">
            <ACTION sym="nav@klish">pop</ACTION>
        </COMMAND>
    </VIEW>

    <VIEW name="view_interface">

        <PROMPT name="prompt">
            <ACTION sym="script">
                IFACE=$(cat /tmp/klish_sess_${KLISH_PID}_iface 2>/dev/null)
                echo -n "NetLab(config-if-${IFACE})# "
            </ACTION>
        </PROMPT>

        <COMMAND name="ip" help="Internet Protocol">
            <COMMAND name="address" help="Set IP address">
                <PARAM name="addr" help="IP Address (e.g. 192.168.1.1/24)" ptype="STRING">
                    <ACTION sym="script">
                        /opt/netlab-cli/scripts/iface_manager.sh set_ip "${KLISH_PARAM_addr}"
                    </ACTION>
                </PARAM>
            </COMMAND>
        </COMMAND>

        <COMMAND name="shutdown" help="Disable the interface">
            <ACTION sym="script">
                /opt/netlab-cli/scripts/iface_manager.sh shutdown
            </ACTION>
        </COMMAND>

        <COMMAND name="exit" help="Go back">
            <ACTION sym="script">
                rm -f /tmp/klish_sess_${KLISH_PID}_iface
            </ACTION>
            <ACTION sym="nav@klish">pop</ACTION>
        </COMMAND>

    </VIEW>

</KLISH>