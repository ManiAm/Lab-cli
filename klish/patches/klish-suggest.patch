index 0000000..f0fe90e
--- /dev/null
+++ b/klish/ksession/ksession_suggest.c
@@ -0,0 +1,47 @@
+/** @file ksession_suggest.c
+ *
+ * Generic hook for smart command suggestions on parse failure.
+ * Delegates to an external script so the suggestion algorithm can be
+ * swapped without recompiling klish.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <faux/error.h>
+#include <faux/str.h>
+
+#include "ksession_suggest.h"
+
+#ifndef KLISH_SUGGEST_SCRIPT
+#define KLISH_SUGGEST_SCRIPT "/opt/netlab-cli/scripts/suggest.py"
+#endif
+
+#define SUGGEST_BUF_SIZE 1024
+
+
+void ksession_suggest(const char *line, faux_error_t *error)
+{
+	char buf[SUGGEST_BUF_SIZE];
+	FILE *fp = NULL;
+
+	if (!line || !error)
+		return;
+
+	setenv("KLISH_SUGGEST_LINE", line, 1);
+
+	fp = popen(KLISH_SUGGEST_SCRIPT, "r");
+	if (!fp)
+		return;
+
+	while (fgets(buf, sizeof(buf), fp)) {
+		size_t slen = strlen(buf);
+		if (slen > 0 && buf[slen - 1] == '\n')
+			buf[slen - 1] = '\0';
+		if (strlen(buf) > 0)
+			faux_error_sprintf(error, "%s", buf);
+	}
+
+	pclose(fp);
+}
